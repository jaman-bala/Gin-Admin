# ── Server ────────────────────────────────────────────────────────────────────
SERVER_PORT=8080
SERVER_READ_TIMEOUT=10
SERVER_WRITE_TIMEOUT=10
TRUSTED_PROXIES=

# ── Database (локально: порт 5412 смапирован Docker'ом) ───────────────────────
DB_HOST=localhost
DB_PORT=5412
DB_USER=chatuser
DB_PASSWORD=chatpassword
DB_NAME=chatdb
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25
DB_CONN_MAX_LIFETIME_HOURS=1

# ── JWT ───────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRY_HOURS=24
JWT_REFRESH_EXPIRY_HOURS=168

# ── Redis (локально: порт 6313 смапирован Docker'ом) ──────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6313
REDIS_PASSWORD=
REDIS_DB=0

# ── MinIO (локально: порт 9000 смапирован Docker'ом) ──────────────────────────
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_PUBLIC_HOST=localhost:9000
MINIO_BUCKET_NAME=chat-uploads
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_SSL=false