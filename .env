# ==========================================
# GIN AUTH SERVICE - ENVIRONMENT VARIABLES
# ==========================================

# --- SERVER ---
SERVER_PORT=8082
GIN_MODE=debug # release - in production

# --- DATABASE (PostgreSQL) ---
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=secretpassword
DB_NAME=authdb
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_HOURS=1

# --- CACHE (Redis) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- STORAGE (MinIO) ---
MINIO_HOST=minio
MINIO_PORT=9000

MINIO_PUBLIC_HOST=localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=adminpassword
MINIO_SSL=false
MINIO_BUCKET_NAME=avatars

# --- SECURITY (JWT) ---
# This is what the code expects for JWT validation
SECRET_KEY=supersecretjwtkey_please_change_me
JWT_EXPIRY_HOURS=24
JWT_REFRESH_EXPIRY_HOURS=168


ADMIN_DEFAULT_PASSWORD=P@sSw0rd123!*
ADMIN_DEFAULT_PHONE=+996500500500